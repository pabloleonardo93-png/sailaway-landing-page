  "include": ["playwright.config.ts", "playwright.ssg.config.ts", "playwright.estrito.config.ts", "playwright.seo.config.ts", "tests/e2e/**/*.ts", "tests/ssg/**/*.ts", "tests/ssg-estrito/**/*.ts", "tests/ssg-estrito/**/*.tsx", "tests/seo/**/*.ts", "src/vite-env.d.ts"]
}
